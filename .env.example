# Copy this file to .env and fill in your credentials.

APP_ENV=local
PROJECT_NAME=Arabic Herbal Health Blog System

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEMPERATURE=0.5
ENABLE_IMAGES=true
IMAGE_SIZE=1024x1024
IMAGE_GEN_PROMPT=Herbal medicine illustration, black seed, honey, natural background, professional Arabic health blog style

# NewsAPI
NEWSAPI_KEY=your-newsapi-key

# Blogger
BLOGGER_BLOG_ID=your-blog-id
# Option A: First run with Google OAuth client file.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Option B: Use refresh-token auth instead.
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_PUBLISH_AS_DRAFT=true

# Optional image hosting. Without these, images are generated locally but not embedded publicly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=auto-blog

# Sources and SEO
RSS_FEEDS=https://www.webteb.com/rss,https://www.aljazeera.net/xml/rss/health.xml
# HEALTH_KEYWORDS can be comma-separated Arabic keywords if you want to override defaults.
BLOG_LABELS=
TARGET_COUNTRY=SA
SITE_BASE_URL=

# Runtime
MAX_ARTICLES_PER_RUN=3
SCHEDULE_INTERVAL_HOURS=4
REQUEST_TIMEOUT_SECONDS=20
FETCH_DELAY_SECONDS=1.5
USER_AGENT=ArabicHerbalHealthBot/1.0 (+contact@example.com; compliant RSS/news fetcher)
DB_PATH=auto_blog.sqlite3
LOG_DIR=logs
GENERATED_DIR=generated
